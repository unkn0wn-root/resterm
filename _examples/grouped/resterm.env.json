{
    "$shared": {
        "base": {
            "url": "http://127.0.0.1:8080"
        }
    },
    "$groups": {
        "api": {
            "$default": "dev",
            "dev": {
                "api": {
                    "tier": "dev",
                    "version": "2026-07-dev"
                }
            },
            "stage": {
                "api": {
                    "tier": "stage",
                    "version": "2026-07-rc"
                }
            },
            "prod": {
                "api": {
                    "tier": "prod",
                    "version": "2026-07"
                }
            }
        },
        "credentials": {
            "$default": "personal",
            "personal": {
                "identity": {
                    "profile": "personal",
                    "clientId": "resterm-local",
                    "token": "personal-demo-token"
                }
            },
            "ci": {
                "identity": {
                    "profile": "ci",
                    "clientId": "resterm-ci",
                    "token": "ci-demo-token"
                }
            },
            "operator": {
                "identity": {
                    "profile": "operator",
                    "clientId": "resterm-operator",
                    "token": "operator-demo-token"
                }
            }
        },
        "region": {
            "$default": "eu-west",
            "eu-west": {
                "deployment": {
                    "code": "eu-west-1",
                    "name": "Europe West"
                }
            },
            "us-east": {
                "deployment": {
                    "code": "eu-east-1",
                    "name": "EU East"
                }
            },
            "ap-tokyo": {
                "deployment": {
                    "code": "ap-northeast-1",
                    "name": "Asia Pacific"
                }
            }
        }
    }
}
