# Run requests as steps. Each step can pass values on to the next one.
# Use @if to pick a step and @for-each to repeat one over a list.

# @workflow signup
# @step Create using=CreateUser expect.statuscode=201
# @step Fetch using=GetUser expect.statuscode=200

### Create user
# @name CreateUser
# @capture file user.id {{response.json.id}}
POST {{base.url}}/users

### Get user
# @name GetUser
GET {{base.url}}/users/{{user.id}}
