# No ssh -L or kubectl port-forward first. Resterm opens the tunnel for the request.

### Through a bastion
# @ssh request host=bastion.example.com user=ops key=~/.ssh/id_ed25519
GET http://10.0.0.10/v1/health

### Through a Kubernetes port-forward
# @k8s namespace=default service=api port=http
GET http://api.default.svc.cluster.local/v1/health
