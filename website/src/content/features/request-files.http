# Requests are plain text in .http or .rest files.
# The # @ lines on top name the request, capture the token and check the status.

### Log in
# @name login
# @capture file auth.token {{response.json.token}}
# @assert response.statusCode == 200
POST {{base.url}}/login
Content-Type: application/json

{"user": "ada", "password": "{{password}}"}
