---
import Features from '../components/home/Features.astro';
import Install from '../components/home/Install.astro';
import RunDemo from '../components/home/RunDemo.astro';
import Tour from '../components/home/Tour.astro';
import Wordmark from '../components/Wordmark.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';

const hints: [string, string][] = [
  ['/', 'Search'],
  ['g d', 'Docs'],
  ['j/k', 'Scroll'],
  ['t', 'Theme'],
  ['?', 'Help'],
];

const links = [
  { icon: '◇', name: 'GitHub', note: 'source and issues', href: site.repo },
  { icon: '⇄', name: 'Releases', note: 'changelog and binaries', href: `${site.repo}/releases` },
  { icon: '♥', name: 'Sponsor', note: 'support the work', href: site.sponsor },
  { icon: '▣', name: 'Docs', note: 'guides and reference', href: '/docs/' },
];
---

<Base current="home" {hints} status={{ file: 'index.http', focus: 'Home' }}>
  <section class="hero">
    <Wordmark animate class="mark" />
    <h1>An API-as-code workbench for the terminal.</h1>
    <p class="lead">
      Resterm is an open source API client that keeps requests in plain <code>.http</code> files next to your code. Use
      the keyboard-driven TUI, or run the same files in CI with <code>resterm run</code>.
    </p>
    <div class="cta">
      <div class="brew">
        <code>
          <span class="prompt" aria-hidden="true">
            ${' '}
          </span>
          brew install resterm
        </code>
        <button type="button" data-copy="brew install resterm">
          copy
        </button>
      </div>
      <a class="button primary" href="/docs/quick-start/">
        Quick start ▸
      </a>
      <a class="button" href="/docs/">
        Read the docs
      </a>
    </div>
    <p class="facts">
      <span>HTTP</span>
      <span>GraphQL</span>
      <span>gRPC</span>
      <span>WebSocket</span>
      <span>SSE</span>
      <span class="gap">macOS, Linux, Windows</span>
      <span>{site.license}</span>
    </p>
  </section>

  <section class="band">
    <header class="sec">
      <h2>
        <span class="sep" aria-hidden="true">
          ###
        </span>
        Take the tour
      </h2>
      <p>Click the screen and press the keys shown under it, or use the buttons.</p>
    </header>
    <Tour />
  </section>

  <section class="band">
    <RunDemo>
      <header class="sec">
        <h2>
          <span class="sep" aria-hidden="true">
            ###
          </span>
          Requests are plain text
        </h2>
        <p>
          Requests, mocks, workflows, environments: almost everything in Resterm is a file in your repo. Use your usual
          editor, or Resterm's terminal UI if you want autocomplete. Changes show up in <code>git diff</code> just like
          any other code. Below, <code>requests.http</code> holds both the requests and their mocks, so no real backend
          is needed.
        </p>
      </header>
    </RunDemo>
  </section>

  <section class="band">
    <header class="sec">
      <h2>
        <span class="sep" aria-hidden="true">
          ###
        </span>
        What it does
      </h2>
      <p>Pick a feature to see how it looks in a request file.</p>
    </header>
    <Features />
  </section>

  <section class="band" id="install">
    <header class="sec">
      <h2>
        <span class="sep" aria-hidden="true">
          ###
        </span>
        Install
      </h2>
      <p>A single binary for macOS, Linux and Windows.</p>
    </header>
    <Install />
  </section>

  <section class="band last">
    <div class="closing">
      <div class="pane pane-response response">
        <span class="pane-title">Response</span>
        <dl>
          <div>
            <dt>Status</dt>
            <dd class="ok">200 OK</dd>
          </div>
          <div>
            <dt>Telemetry</dt>
            <dd>none</dd>
          </div>
          <div>
            <dt>Account</dt>
            <dd>none</dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>{site.license}</dd>
          </div>
        </dl>
        <p class="body">Free and open source. Your requests stay plain text in your repo.</p>
      </div>
      <nav class="pane links" aria-label="Project links">
        <span class="pane-title">Links</span>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href}>
                <span class="icon" aria-hidden="true">
                  {l.icon}
                </span>
                <span class="name">{l.name}</span>
                <span class="note">{l.note}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .hero,
  .band {
    width: min(96rem, 100%);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .hero {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .hero :global(.mark) {
    width: min(34rem, 92%);
    margin: 0 auto;
  }

  h1 {
    max-width: 26ch;
    margin: clamp(1.75rem, 4vw, 2.75rem) auto 0;
    font-size: clamp(1.7rem, 4.2vw, 2.9rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--fg-strong);
    text-wrap: balance;
  }

  .lead {
    max-width: 38rem;
    margin: 1.25rem auto 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    line-height: 1.65;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .lead code,
  .sec code {
    font-size: 0.9em;
    color: var(--syn-value);
    white-space: nowrap;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .brew {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 0.5rem 0 1rem;
    border: 1px solid var(--line-strong);
    background: var(--bg-pane);
    font-size: 0.9rem;
  }

  .brew code {
    color: var(--fg-strong);
  }

  .prompt {
    color: var(--response);
    user-select: none;
  }

  .brew button {
    padding: 0.4rem 0.5rem;
    border: 0;
    background: none;
    color: var(--fg-dim);
    font-size: 0.875rem;
  }

  .brew button:hover {
    color: var(--key);
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--line-strong);
    color: var(--fg-strong);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .button:hover {
    border-color: var(--fg-muted);
    background: var(--bg-hover);
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-fg);
  }

  .button.primary:hover {
    background: color-mix(in srgb, var(--accent) 85%, white);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 2ch;
    margin-top: 1.75rem;
    font-size: 0.875rem;
    color: var(--fg-dim);
  }

  .facts .gap {
    margin-left: 2ch;
  }

  .band {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .sec {
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .sec h2 {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 600;
    color: var(--fg-strong);
  }

  .sep {
    margin-right: 1ch;
    color: var(--syn-separator);
    font-weight: 400;
  }

  .sec p {
    margin-top: 0.6rem;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.0625rem);
    color: var(--fg-muted);
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* Same columns as Install and Quick start above. */
  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.25rem;
    font-size: 0.9rem;
  }

  .response {
    padding: 1.5rem clamp(1rem, 3vw, 2rem);
  }

  dl div {
    display: flex;
    gap: 1ch;
    line-height: 1.8;
  }

  dt {
    color: var(--syn-key);
  }

  dt::after {
    content: ':';
  }

  dl,
  dd {
    margin: 0;
  }

  dd {
    color: var(--fg-strong);
  }

  dd.ok {
    color: var(--ok);
    font-weight: 600;
  }

  .body {
    margin-top: 1.25rem;
    color: var(--fg-strong);
    line-height: 1.8;
  }

  .links {
    padding: 1.4rem 0.75rem;
  }

  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Rows look like the navigator: the cursor marker shows on the row under
     the pointer or keyboard focus. */
  .links a {
    display: flex;
    gap: 1ch;
    padding: 0.2rem 0.75ch;
    color: var(--fg);
    text-decoration: none;
  }

  .links a::before {
    content: '';
    width: 1ch;
    flex: none;
  }

  .links a:hover,
  .links a:focus-visible {
    background: var(--bg-hover);
    color: var(--fg-strong);
  }

  .links a:hover::before,
  .links a:focus-visible::before {
    content: '›';
    color: var(--focus);
  }

  :global(:root[data-theme='light']) .links a::before {
    color: var(--fg-strong);
  }

  .icon {
    color: var(--icon);
  }

  .name {
    width: 9ch;
    flex: none;
  }

  .note {
    color: var(--fg-dim);
  }

  @media (max-width: 960px) {
    .closing {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .brew {
      width: 100%;
      justify-content: space-between;
    }
    .button {
      flex: 1;
      justify-content: center;
    }
    .facts .gap {
      margin-left: 0;
    }
  }
</style>
