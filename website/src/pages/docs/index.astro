---
import GroupList from '../../components/docs/GroupList.astro';
import Docs from '../../layouts/Docs.astro';
import { getDocs } from '../../lib/docs';
import { version } from '../../lib/version';

const { groups, pages } = await getDocs();
const start = [
  { href: '/docs/install/', label: 'Install' },
  { href: '/docs/quick-start/', label: 'Quick start' },
  { href: '/docs/request-files/', label: 'Request files' },
  { href: '/docs/cli/run/', label: 'resterm run' },
];
---

<Docs
  title="Documentation"
  description="Everything about Resterm: request files, directives, protocols, automation, RestermScript and the CLI."
  groups={groups}
  href="/docs/"
  status={{ file: 'docs/', focus: 'Index' }}
  next={pages[0]?.href}
>
  <div class="index">
    <header class="head">
      <h1>
        <span class="hmark" aria-hidden="true">
          #
        </span>
        Documentation
      </h1>
      <p class="lead">
        The reference for request files, directives, protocols, automation, RestermScript and the CLI. These pages match
        v{version}, the latest release. Run <code>resterm --version</code> to check yours.
      </p>
      <button class="search" type="button" data-search-open>
        <span class="key">/</span> Search {pages.length} pages
      </button>
      <p class="start">
        <span class="label-pixel">Start here</span>
        {start.map((s) => (
          <a href={s.href}>{s.label}</a>
        ))}
      </p>
    </header>

    <GroupList groups={groups} />
  </div>
</Docs>

<style>
  .head {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--fg-strong);
  }

  .hmark {
    margin-right: 1ch;
    color: var(--fg-dim);
    font-weight: 400;
  }

  .lead {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: var(--fg-muted);
  }

  .lead code {
    font-size: 0.9em;
    color: var(--syn-value);
  }

  .search {
    display: flex;
    gap: 1ch;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-pane);
    color: var(--fg-dim);
    text-align: left;
  }

  .search:hover {
    border-color: var(--editor);
  }

  .key {
    color: var(--key);
    font-weight: 600;
  }

  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2ch;
    margin-top: 1.1rem;
    font-size: 0.875rem;
  }

  .start a {
    color: var(--accent-text);
  }
</style>
