---
import type { Page } from '../../lib/docs';

type Props = Pick<Page, 'toc' | 'source'>;

const { toc, source } = Astro.props;
---

<aside class="outline pane" aria-label="On this page">
  <span class="pane-title">Outline</span>
  <div class="scroll">
    {toc.length > 0 && (
      <ol>
        {toc.map((t) => (
          <li class={`d${t.depth}`}>
            <a href={`#${t.id}`} data-outline={t.id}>
              {t.text}
            </a>
          </li>
        ))}
      </ol>
    )}
    <p class="source">
      <a href={source.url}>{source.path}</a>
    </p>
  </div>
</aside>

<style>
  .d3 {
    padding-left: 2ch;
  }

  .source {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
  }

  .source a {
    padding-left: 0;
    color: var(--fg-dim);
    overflow-wrap: anywhere;
  }

  .source a::before {
    content: '⇄ ';
    color: var(--icon);
  }
</style>
