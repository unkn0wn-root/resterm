---
import authentication from '../../content/features/authentication.http?raw';
import mockServers from '../../content/features/mock-servers.http?raw';
import protocols from '../../content/features/protocols.http?raw';
import recording from '../../content/features/recording.http?raw';
import requestFiles from '../../content/features/request-files.http?raw';
import restermRun from '../../content/features/resterm-run.http?raw';
import restermscript from '../../content/features/restermscript.http?raw';
import tracing from '../../content/features/tracing.http?raw';
import tunnels from '../../content/features/tunnels.http?raw';
import workflows from '../../content/features/workflows.http?raw';
import { getExamples } from '../../lib/examples';
import { docHref } from '../../site';
import EditorCode from '../EditorCode.astro';

// Tones are the .method-* classes in src/styles/base.css.
type Tone = 'get' | 'post' | 'put' | 'patch' | 'delete' | 'grpc' | 'ws' | 'options' | 'rts';

interface Feature {
  badge: string;
  tone: Tone;
  name: string;
  href: string;
  code: string;
  // Slug of the matching page under /examples/.
  example: string;
}

const features: Feature[] = [
  {
    badge: 'HTTP',
    tone: 'get',
    name: 'request-files',
    href: docHref('request-files'),
    code: requestFiles,
    example: 'basic',
  },
  {
    badge: 'GRPC',
    tone: 'grpc',
    name: 'protocols',
    href: docHref('grpc'),
    code: protocols,
    example: 'grpc',
  },
  {
    badge: 'WF',
    tone: 'post',
    name: 'workflows',
    href: docHref('workflows'),
    code: workflows,
    example: 'workflows',
  },
  {
    badge: 'MOCK',
    tone: 'put',
    name: 'mock-servers',
    href: docHref('mock-servers'),
    code: mockServers,
    example: 'mocks',
  },
  {
    badge: 'REC',
    tone: 'delete',
    name: 'recording',
    href: docHref('recording'),
    code: recording,
    example: 'recording',
  },
  {
    badge: 'AUTH',
    tone: 'patch',
    name: 'authentication',
    href: docHref('authentication'),
    code: authentication,
    example: 'auth_command',
  },
  {
    badge: 'SSH',
    tone: 'ws',
    name: 'tunnels',
    href: docHref('ssh-tunnels'),
    code: tunnels,
    example: 'ssh',
  },
  {
    badge: 'TRACE',
    tone: 'options',
    name: 'tracing',
    href: docHref('ui-tour', 'timeline--tracing'),
    code: tracing,
    example: 'trace',
  },
  {
    badge: 'RTS',
    tone: 'rts',
    name: 'restermscript',
    href: docHref('rts'),
    code: restermscript,
    example: 'rts/rts_all_features',
  },
  {
    badge: 'RUN',
    tone: 'get',
    name: 'resterm-run',
    href: docHref('cli/run'),
    code: restermRun,
    example: 'service-groups',
  },
];

const { pages } = await getExamples();
const panels = features.map((f) => {
  const page = pages.find((p) => p.slug === f.example);
  if (!page) {
    throw new Error(`no example "${f.example}" in docs/examples.md`);
  }

  return { ...f, page };
});
---

<div class="features" data-tabs>
  <div class="pane files">
    <span class="pane-title">Files</span>
    <p class="file" aria-hidden="true">
      <span class="mark">•</span>
      <span class="mark">▾</span>
      features.http ({features.length})
    </p>
    <div role="tablist" aria-label="Features" aria-orientation="vertical">
      {features.map((f, i) => (
        <button
          type="button"
          role="tab"
          id={`feature-tab-${f.name}`}
          aria-controls={`feature-${f.name}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class={`method method-${f.tone}`}>{f.badge}</span>
          <span class="name">{f.name}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="pane pane-editor editor">
    {panels.map((f, i) => (
      <div
        class="panel"
        id={`feature-${f.name}`}
        role="tabpanel"
        aria-labelledby={`feature-tab-${f.name}`}
        hidden={i !== 0}
      >
        <span class="pane-title">{f.name}.http</span>
        <EditorCode code={f.code} />
        <p class="pane-foot">
          <a href={f.href}>
            <span aria-hidden="true">▣</span> {f.name} docs
          </a>
          <a href={f.page.href}>
            <span aria-hidden="true">◧</span> {f.page.title} example
          </a>
        </p>
      </div>
    ))}
  </div>
</div>

<style>
  .features {
    display: grid;
    grid-template-columns: minmax(max-content, 18rem) minmax(0, 1fr);
    gap: 1.25rem;
  }

  .files {
    padding: 1rem 0.5rem 0.75rem;
    font-size: 0.875rem;
  }

  /* The border shows keyboard focus, like the focused pane in the TUI. */
  .files:has(:focus-visible) {
    --pane-border: var(--focus);
    --pane-title: var(--focus);
  }

  .file {
    display: flex;
    gap: 1ch;
    padding: 0.2rem 0.75ch;
    color: var(--fg-strong);
    font-weight: 600;
  }

  .mark {
    color: var(--fg-dim);
    font-weight: 400;
  }

  [role='tab'] {
    display: grid;
    grid-template-columns: 1ch 5ch minmax(0, 1fr);
    gap: 1ch;
    width: 100%;
    padding: 0.2rem 0.75ch 0.2rem 2.75ch;
    border: 0;
    background: none;
    color: var(--fg);
    text-align: left;
  }

  [role='tab']::before {
    content: '';
    color: var(--focus);
  }

  [role='tab']:hover {
    background: var(--bg-hover);
  }

  [role='tab']:focus-visible {
    outline: none;
  }

  [role='tab'][aria-selected='true'] {
    background: var(--bg-sel);
  }

  [role='tab'][aria-selected='true']::before {
    content: '›';
  }

  :root[data-theme='light'] [role='tab'][aria-selected='true']::before {
    color: var(--fg-strong);
  }

  [aria-selected='true'] .name {
    color: var(--fg-strong);
    font-weight: 600;
  }

  .editor {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Panels share one cell and hidden ones keep their space, so the pane fits
     the longest example and does not resize when the selection changes. */
  .panel[hidden] {
    display: flex;
    visibility: hidden;
  }

  @media (max-width: 960px) {
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
